<Window x:Class="Bitcoin_Widget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BitcoinWidget"
    Height="50"
    Width="155"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True">   


    <Grid Background="#1E1E1E">

        <TextBlock
        x:Name="StatusText"
        Text="🔒"
        FontSize="12"
        Foreground="White"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,16,4,0"/>

        <StackPanel Margin="2">

            <TextBlock
            x:Name="BtcText"
            Text="BTC/USD"
            FontSize="15"
            Foreground="#F7931A"
            Margin="0,0,0,0"
            FontFamily="Segoe UI Variable"
            FontWeight="SemiBold"/>

            <TextBlock
            x:Name="UsdText"
            Text="USD/BRL"
            FontSize="15"
            Foreground="#4CAF50"
            FontFamily="Segoe UI Variable"
            FontWeight="SemiBold"/>

        </StackPanel>

    </Grid>
</Window>
