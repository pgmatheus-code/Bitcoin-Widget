<Window x:Class="Bitcoin_Widget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bitcoin Widget"
        Width="155"
        Height="50"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True">

    <!--
        Main Layout

        StatusText : Lock / Unlock indicator
        BtcText    : Bitcoin price (BTC/USD)
        UsdText    : Dollar price (USD/BRL)
    -->

    <Grid Background="#1E1E1E">

        <!-- Lock status -->
        <TextBlock x:Name="StatusText"
                   Text="🔒"
                   FontSize="12"
                   Foreground="White"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,16,4,0" />

        <!-- Market data -->
        <StackPanel Margin="2">

            <TextBlock x:Name="BtcText"
                       Text="BTC/USD"
                       FontSize="15"
                       FontFamily="Segoe UI Variable"
                       FontWeight="SemiBold"
                       Foreground="#F7931A" />

            <TextBlock x:Name="UsdText"
                       Text="USD/BRL"
                       FontSize="15"
                       FontFamily="Segoe UI Variable"
                       FontWeight="SemiBold"
                       Foreground="#4CAF50" />

        </StackPanel>

    </Grid>

</Window>